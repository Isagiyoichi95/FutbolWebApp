38324>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38327>>>        Case Begin
38327>>>            Case (NavigateData.eNavigateType = nfFromMain)
38329>>>                // If from main, this is a propbably a main file Select to Zoom.
38329>>>                Case Break
38330>>>
38330>>>            Case (NavigateData.eNavigateType = nfFromParent)
38333>>>                // If from parent, this is a constrained drill down.
38333>>>                Case Break
38334>>>
38334>>>            Case (NavigateData.eNavigateType = nfFromChild)
38337>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38337>>>                Case Break
38338>>>
38338>>>            Case Else // must be nfUndefined
38338>>>
38338>>>        Case End
38338>>>
38338>>>        Send SetActionButtons
38339>>>
38339>>>    End_Procedure
