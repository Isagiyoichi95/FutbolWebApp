38492>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38495>>>        WebSet pbRender of oNewButton to True
38496>>>        WebSet pbRender of oDetailButton to True
38497>>>
38497>>>        Case Begin
38497>>>            Case (NavigateData.eNavigateType = nfFromParent)
38499>>>                // If from parent, this is a constrained drill down
38499>>>                // If Row select does main-zoom we don't need this
38499>>>                WebSet pbRender of oDetailButton to False
38500>>>                Case Break
38501>>>
38501>>>            Case (NavigateData.eNavigateType = nfFromChild)
38504>>>                // If from child, this is a probably a parent lookup from a Zoom
38504>>>                Case Break
38505>>>
38505>>>            Case (NavigateData.eNavigateType = nfFromMain)
38508>>>                // If from main, this is a probably a main-file lookup from a Zoom
38508>>>                WebSet pbRender of oDetailButton to False
38509>>>                Case Break
38510>>>
38510>>>            Case Else // must be nfUndefined
38510>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38510>>>                // If Row select does main-zoom we don't need this
38510>>>                WebSet pbRender of oDetailButton to False
38511>>>
38511>>>        Case End
38511>>>
38511>>>    End_Procedure
