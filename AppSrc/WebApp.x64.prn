38299>>>        tWebNavigateData NavigateData
38299>>>        tWebNavigateData NavigateData
38299>>>        Boolean bHasRecord
38299>>>        Handle hoDD
38299>>>
38299>>>        Get Server to hoDD
38300>>>        Get GetNavigateData to NavigateData
38301>>>        Get HasRecord of hoDD to bHasRecord
38302>>>
38302>>>        // let's hide all buttons and then Show the ones we want
38302>>>        WebSet pbRender of oEditBtn to False
38303>>>        WebSet pbRender of oSaveBtn to False
38304>>>        WebSet pbRender of oCancelChangesBtn to False
38305>>>        WebSet pbRender of oDeleteBtn to False
38306>>>
38306>>>        If (NavigateData.bReadOnly) Begin
38308>>>            WebSet pbRender of oEditBtn to True
38309>>>        End
38309>>>>
38309>>>        Else Begin
38310>>>            WebSet pbRender of oSaveBtn to True
38311>>>            WebSet pbRender of oCancelChangesBtn to True
38312>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38313>>>        End
38313>>>>
